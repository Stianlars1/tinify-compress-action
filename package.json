{
  "name": "tinify-compress-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that compresses PNG/JPEG/WebP/AVIF images with the Tinify.dev API - honest savings, job summary, optional sticky PR comment.",
  "license": "MIT",
  "author": "Stian Larsen",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@actions/glob": "^0.5.0",
    "@tinify-dev/client": "file:../tinify-sdk-js"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
